<Application x:Class="CncPrieniky3D.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <!-- Tomorrow Night Blue (Cursor) -->
    <Color x:Key="C.Bg">#FF002451</Color>
    <Color x:Key="C.BgDeep">#FF001833</Color>
    <Color x:Key="C.Panel">#FF001C40</Color>
    <Color x:Key="C.Elevated">#FF00346E</Color>
    <Color x:Key="C.Border">#FF234E87</Color>
    <Color x:Key="C.Fg">#FFFFFFFF</Color>
    <Color x:Key="C.FgMuted">#FFA8B8D8</Color>
    <Color x:Key="C.FgDim">#FF7285B7</Color>
    <Color x:Key="C.Accent">#FF82AAFF</Color>
    <Color x:Key="C.AccentHi">#FFBBDAFF</Color>
    <Color x:Key="C.Danger">#FFFF9DA4</Color>
    <Color x:Key="C.Ok">#FFD1F1A9</Color>

    <SolidColorBrush x:Key="AppBg" Color="{StaticResource C.Bg}"/>
    <SolidColorBrush x:Key="AppBgDeep" Color="{StaticResource C.BgDeep}"/>
    <SolidColorBrush x:Key="AppPanel" Color="{StaticResource C.Panel}"/>
    <SolidColorBrush x:Key="AppElevated" Color="{StaticResource C.Elevated}"/>
    <SolidColorBrush x:Key="AppBorder" Color="{StaticResource C.Border}"/>
    <SolidColorBrush x:Key="AppFg" Color="{StaticResource C.Fg}"/>
    <SolidColorBrush x:Key="AppFgMuted" Color="{StaticResource C.FgMuted}"/>
    <SolidColorBrush x:Key="AppFgDim" Color="{StaticResource C.FgDim}"/>
    <SolidColorBrush x:Key="AppAccent" Color="{StaticResource C.Accent}"/>
    <SolidColorBrush x:Key="AppAccentHi" Color="{StaticResource C.AccentHi}"/>

    <Style TargetType="Window">
      <Setter Property="Background" Value="{StaticResource AppBg}"/>
      <Setter Property="Foreground" Value="{StaticResource AppFg}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource AppFg}"/>
    </Style>

    <Style TargetType="Label">
      <Setter Property="Foreground" Value="{StaticResource AppFg}"/>
    </Style>

    <Style TargetType="Separator">
      <Setter Property="Background" Value="{StaticResource AppBorder}"/>
      <Setter Property="Margin" Value="6,4"/>
    </Style>

    <Style TargetType="Border" x:Key="PanelBorder">
      <Setter Property="Background" Value="{StaticResource AppPanel}"/>
      <Setter Property="BorderBrush" Value="{StaticResource AppBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="10"/>
    </Style>

    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource AppFg}"/>
      <Setter Property="Background" Value="{StaticResource AppElevated}"/>
      <Setter Property="BorderBrush" Value="{StaticResource AppBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,5"/>
      <Setter Property="Margin" Value="2"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="5"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AppAccent}"/>
                <Setter Property="Foreground" Value="#001833"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AppAccentHi}"/>
                <Setter Property="Foreground" Value="#001833"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ToggleButton">
      <Setter Property="Foreground" Value="{StaticResource AppFgMuted}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="{StaticResource AppBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,4"/>
      <Setter Property="Margin" Value="2"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="5"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AppElevated}"/>
                <Setter Property="Foreground" Value="{StaticResource AppFg}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AppElevated}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AppAccent}"/>
                <Setter Property="Foreground" Value="{StaticResource AppAccentHi}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource AppFg}"/>
      <Setter Property="Margin" Value="4,2"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="5"
                    BorderBrush="Transparent" BorderThickness="1"
                    Padding="8,4">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AppElevated}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AppElevated}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AppAccent}"/>
                <Setter Property="Foreground" Value="{StaticResource AppAccentHi}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource AppFg}"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="#FFFFFFFF"/>
      <Setter Property="Background" Value="{StaticResource AppElevated}"/>
      <Setter Property="BorderBrush" Value="{StaticResource AppBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="CaretBrush" Value="{StaticResource AppAccentHi}"/>
      <Setter Property="SelectionBrush" Value="{StaticResource AppBorder}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4">
              <ScrollViewer x:Name="PART_ContentHost"
                            Margin="{TemplateBinding Padding}"
                            VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AppAccent}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{StaticResource AppFg}"/>
      <Setter Property="Background" Value="{StaticResource AppBgDeep}"/>
      <Setter Property="BorderBrush" Value="{StaticResource AppBorder}"/>
      <Setter Property="Padding" Value="4,3"/>
    </Style>

    <Style TargetType="ListBox">
      <Setter Property="Background" Value="{StaticResource AppBgDeep}"/>
      <Setter Property="Foreground" Value="{StaticResource AppFg}"/>
      <Setter Property="BorderBrush" Value="{StaticResource AppBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="2"/>
    </Style>

    <Style TargetType="ListBoxItem">
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="Margin" Value="1"/>
      <Setter Property="Foreground" Value="{StaticResource AppFg}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AppElevated}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AppElevated}"/>
                <Setter Property="Foreground" Value="{StaticResource AppAccentHi}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TreeView">
      <Setter Property="Background" Value="{StaticResource AppBgDeep}"/>
      <Setter Property="Foreground" Value="{StaticResource AppFg}"/>
      <Setter Property="BorderBrush" Value="{StaticResource AppBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="4"/>
    </Style>

    <Style TargetType="TreeViewItem">
      <Setter Property="Foreground" Value="{StaticResource AppFg}"/>
      <Setter Property="Padding" Value="2,2"/>
    </Style>

    <!-- Cursor / VS Code editor tabs -->
    <Style TargetType="TabControl">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabControl">
            <DockPanel LastChildFill="True">
              <Border DockPanel.Dock="Top"
                      Background="{StaticResource AppPanel}"
                      BorderBrush="{StaticResource AppBorder}"
                      BorderThickness="0,0,0,1"
                      CornerRadius="6,6,0,0"
                      Padding="4,0,4,0"
                      MinHeight="36">
                <TabPanel IsItemsHost="True" VerticalAlignment="Bottom"/>
              </Border>
              <Border Background="Transparent" Margin="0">
                <ContentPresenter ContentSource="SelectedContent"/>
              </Border>
            </DockPanel>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="{StaticResource AppFgDim}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Grid SnapsToDevicePixels="True">
              <Border x:Name="Bd"
                      Background="Transparent"
                      BorderBrush="Transparent"
                      BorderThickness="1,1,1,0"
                      CornerRadius="6,6,0,0"
                      Padding="{TemplateBinding Padding}"
                      Margin="2,4,2,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <ContentPresenter x:Name="HeaderContent"
                                    ContentSource="Header"
                                    VerticalAlignment="Center"
                                    RecognizesAccessKey="True"/>
                </StackPanel>
              </Border>
              <!-- accent underline ako v Cursori -->
              <Border x:Name="Accent"
                      Height="2"
                      VerticalAlignment="Bottom"
                      Margin="8,0,8,0"
                      Background="Transparent"
                      CornerRadius="1"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#2200346E"/>
                <Setter Property="Foreground" Value="{StaticResource AppFg}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AppBg}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AppBorder}"/>
                <Setter TargetName="Accent" Property="Background" Value="{StaticResource AppAccent}"/>
                <Setter Property="Foreground" Value="{StaticResource AppFg}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsSelected" Value="True"/>
                  <Condition Property="IsMouseOver" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AppBg}"/>
                <Setter Property="Foreground" Value="{StaticResource AppAccentHi}"/>
              </MultiTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="Menu">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource AppFg}"/>
    </Style>

    <Style TargetType="MenuItem">
      <Setter Property="Foreground" Value="{StaticResource AppFg}"/>
      <Setter Property="Background" Value="{StaticResource AppPanel}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="MenuItem">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="Transparent"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="10,5">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ContentPresenter x:Name="HeaderHost"
                                  Grid.Column="0"
                                  ContentSource="Header"
                                  VerticalAlignment="Center"
                                  RecognizesAccessKey="True"/>
                <Path x:Name="Arrow" Grid.Column="1"
                      VerticalAlignment="Center" Margin="6,0,0,0"
                      Fill="{StaticResource AppFgDim}"
                      Data="M 0 0 L 4 4 L 8 0 Z"
                      Visibility="Collapsed"/>
                <Popup x:Name="PART_Popup"
                       Placement="Bottom"
                       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                       AllowsTransparency="True"
                       Focusable="False"
                       PopupAnimation="Fade">
                  <Border Background="{StaticResource AppPanel}"
                          BorderBrush="{StaticResource AppBorder}"
                          BorderThickness="1"
                          CornerRadius="6"
                          Padding="4">
                    <ItemsPresenter/>
                  </Border>
                </Popup>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="Role" Value="TopLevelHeader">
                <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AppElevated}"/>
                <Setter Property="Foreground" Value="{StaticResource AppFg}"/>
              </Trigger>
              <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AppElevated}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AppBorder}"/>
              </Trigger>
              <Trigger Property="Role" Value="SubmenuItem">
                <Setter TargetName="Bd" Property="CornerRadius" Value="4"/>
                <Setter TargetName="Bd" Property="Padding" Value="12,7"/>
                <Setter TargetName="Bd" Property="Margin" Value="2,1"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ContextMenu">
      <Setter Property="Background" Value="{StaticResource AppPanel}"/>
      <Setter Property="Foreground" Value="{StaticResource AppFg}"/>
      <Setter Property="BorderBrush" Value="{StaticResource AppBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="4"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContextMenu">
            <Border Background="{StaticResource AppPanel}"
                    BorderBrush="{StaticResource AppBorder}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="{TemplateBinding Padding}">
              <ItemsPresenter/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ToolBar">
      <Setter Property="Background" Value="{StaticResource AppPanel}"/>
      <Setter Property="Foreground" Value="{StaticResource AppFg}"/>
      <Setter Property="Padding" Value="4,3"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToolBar">
            <Border Background="{StaticResource AppPanel}"
                    BorderBrush="{StaticResource AppBorder}"
                    BorderThickness="0,0,0,1"
                    Padding="4,3">
              <ToolBarPanel IsItemsHost="True"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="Slider">
      <Setter Property="Foreground" Value="{StaticResource AppAccent}"/>
    </Style>

    <Style TargetType="ScrollViewer">
      <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style x:Key="CaptionButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource AppFgMuted}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Arrow"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AppElevated}"/>
                <Setter Property="Foreground" Value="{StaticResource AppFg}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AppBorder}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CaptionButtonClose" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#C42B1C"/>
          <Setter Property="Foreground" Value="White"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource AppAccent}"/>
      <Setter Property="Foreground" Value="#001833"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="BorderBrush" Value="{StaticResource AppAccentHi}"/>
    </Style>

    <Style x:Key="MutedText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource AppFgMuted}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource AppFg}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="DimText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource AppFgDim}"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>

    <Style x:Key="SectionHeader" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource AppAccentHi}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
  </Application.Resources>
</Application>
