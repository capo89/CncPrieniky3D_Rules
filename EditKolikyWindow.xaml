<Window x:Class="CncPrieniky3D.EditKolikyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Upraviť kolíky"
        MinHeight="360" Height="480" MinWidth="720" Width="860"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource AppBg}">
  <DockPanel Margin="14">
    <TextBlock x:Name="TitleText" DockPanel.Dock="Top"
               Margin="0,0,0,4" TextWrapping="Wrap" Style="{StaticResource MutedText}"/>
    <TextBlock x:Name="DetailText" DockPanel.Dock="Top"
               Margin="0,0,0,10" TextWrapping="Wrap" Style="{StaticResource DimText}"/>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Zrušiť" Width="90" Margin="0,0,8,0"
              Click="Cancel_Click" IsCancel="True"/>
      <Button Content="Uložiť" Width="100" Style="{StaticResource PrimaryButton}"
              Click="Ok_Click" IsDefault="True"/>
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
      <Button Content="Pridať sériu" Margin="0,0,8,0" Click="AddRow_Click"/>
      <Button Content="Odstrániť sériu" Click="RemoveRow_Click"
              ToolTip="Odstráni vybranú sériu (alebo poslednú)"/>
    </StackPanel>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="PickerColumn" Width="200"/>
        <ColumnDefinition x:Name="PickerSplitterColumn" Width="8"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <DockPanel x:Name="ContactPickerPanel" Grid.Column="0">
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionHeader}"
                   Text="Plôchy" Margin="0,0,0,6"/>
        <ListBox x:Name="ContactPicker"
                 DisplayMemberPath="Display"
                 SelectionChanged="ContactPicker_SelectionChanged"/>
      </DockPanel>

      <DataGrid x:Name="SerieGrid" Grid.Column="2"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                HeadersVisibility="Column"
                SelectionMode="Single"
                SelectionUnit="FullRow"
                GridLinesVisibility="Horizontal"
                Background="{StaticResource AppBgDeep}"
                Foreground="{StaticResource AppFg}"
                BorderBrush="{StaticResource AppBorder}"
                BorderThickness="1"
                RowBackground="{StaticResource AppBgDeep}"
                AlternatingRowBackground="{StaticResource AppPanel}">
        <DataGrid.Columns>
          <DataGridTextColumn Header="#" Binding="{Binding Cislo}" IsReadOnly="True" Width="36"/>
          <DataGridTextColumn Header="Od predu (mm)" Binding="{Binding OdPredu, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
          <DataGridTextColumn Header="Počet" Binding="{Binding Pocet, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
          <DataGridTextColumn Header="Rozteč (mm)" Binding="{Binding Roztec, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
          <DataGridCheckBoxColumn Header="Zo stredu" Binding="{Binding ZoStredu, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
          <DataGridCheckBoxColumn Header="Z druhej strany" Binding="{Binding ZDruhejStrany, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
        </DataGrid.Columns>
      </DataGrid>
    </Grid>
  </DockPanel>
</Window>
