<Window x:Class="CncPrieniky3D.MarkContactDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Označiť styčnú plochu"
        MinHeight="210" Height="220" MinWidth="440" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource AppBg}">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="Styk dielov" Style="{StaticResource SectionHeader}"/>
    <TextBlock x:Name="InfoText" Grid.Row="1" Margin="0,0,0,12" TextWrapping="Wrap" Style="{StaticResource MutedText}"/>

    <TextBlock Grid.Row="2" Text="Označenie" Margin="0,0,0,4"/>
    <TextBox x:Name="LabelBox" Grid.Row="3" VerticalAlignment="Top"
             KeyDown="LabelBox_KeyDown"/>

    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Zrušiť" Width="90" Margin="0,0,8,0" Click="Cancel_Click" IsCancel="True"/>
      <Button Content="Označiť" Width="90" Style="{StaticResource PrimaryButton}" Click="Ok_Click" IsDefault="True"/>
    </StackPanel>
  </Grid>
</Window>
