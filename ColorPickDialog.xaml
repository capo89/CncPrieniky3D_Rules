<Window x:Class="CncPrieniky3D.ColorPickDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Farba"
        Width="360" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource AppBg}">
  <StackPanel Margin="16">
    <Border x:Name="Preview" Height="48" BorderBrush="{StaticResource AppBorder}" BorderThickness="1" Margin="0,0,0,12" CornerRadius="4"/>
    <Grid Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="28"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="40"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <TextBlock Text="R" VerticalAlignment="Center"/>
      <Slider x:Name="SliderR" Grid.Column="1" Minimum="0" Maximum="255" TickFrequency="1"
              IsSnapToTickEnabled="True" ValueChanged="Slider_Changed" Margin="8,4"/>
      <TextBlock x:Name="LabelR" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"/>
      <TextBlock Text="G" Grid.Row="1" VerticalAlignment="Center"/>
      <Slider x:Name="SliderG" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="255" TickFrequency="1"
              IsSnapToTickEnabled="True" ValueChanged="Slider_Changed" Margin="8,4"/>
      <TextBlock x:Name="LabelG" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"/>
      <TextBlock Text="B" Grid.Row="2" VerticalAlignment="Center"/>
      <Slider x:Name="SliderB" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="255" TickFrequency="1"
              IsSnapToTickEnabled="True" ValueChanged="Slider_Changed" Margin="8,4"/>
      <TextBlock x:Name="LabelB" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"/>
    </Grid>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
      <TextBlock Text="#" VerticalAlignment="Center" Margin="0,0,4,0"/>
      <TextBox x:Name="HexBox" Width="80" VerticalContentAlignment="Center" LostFocus="HexBox_LostFocus"
               KeyDown="HexBox_KeyDown"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Zrušiť" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/>
      <Button Content="OK" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Ok_Click"/>
    </StackPanel>
  </StackPanel>
</Window>
