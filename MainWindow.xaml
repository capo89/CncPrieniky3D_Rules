<Window x:Class="CncPrieniky3D.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helix="http://helix-toolkit.org/wpf"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="CncPrieniky3D_Rules – vizuál + Excel (pravidlá odznova)"
        Height="1080" Width="1800"
        MinHeight="720" MinWidth="1200"
        WindowStartupLocation="CenterScreen">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0"
                        ResizeBorderThickness="5"
                        GlassFrameThickness="0"
                        UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <DockPanel>
    <!-- Titulbar s draggingom + systémové tlačidlá -->
    <Grid DockPanel.Dock="Top" Height="32"
          Background="{StaticResource AppBgDeep}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <!-- Ťahanie okna -->
      <Grid Grid.Column="0" Grid.ColumnSpan="2"
            shell:WindowChrome.IsHitTestVisibleInChrome="True"
            Background="Transparent"
            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <TextBlock Text="CncPrieniky3D"
                   VerticalAlignment="Center" Margin="12,0"
                   FontSize="12" Foreground="{StaticResource AppFgMuted}"
                   IsHitTestVisible="False"/>
      </Grid>

      <!-- Min / Max / Close -->
      <StackPanel Grid.Column="2" Orientation="Horizontal"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True">
        <Button Content="🗕" Width="46" Height="32"
                Click="TitleMin_Click"
                Style="{StaticResource CaptionButton}"/>
        <Button x:Name="TitleMaxBtn" Content="🗖" Width="46" Height="32"
                Click="TitleMax_Click"
                Style="{StaticResource CaptionButton}"/>
        <Button Content="✕" Width="46" Height="32"
                Click="TitleClose_Click"
                Style="{StaticResource CaptionButtonClose}"/>
      </StackPanel>
    </Grid>

    <ToolBar DockPanel.Dock="Top" x:Name="MainToolbar">
      <Button Content="Otvoriť Excel…" Click="OpenExcel_Click"/>
      <Button Content="Otvoriť projekt…" Click="OpenProject_Click"
              ToolTip="Načíta .cnc3d.json (Excel + uložené kolíky/skrutky/vlastnosti)"/>
      <Button Content="Uložiť projekt" Click="SaveProject_Click"
              ToolTip="Uloží kolíky, skrutky a vlastnosti vedľa Excelu (*.cnc3d.json)"/>
      <Separator/>
      <Button x:Name="VlastnostiBtn" Content="Vlastnosti ▾" Click="VlastnostiMenu_Click">
        <Button.ContextMenu>
          <ContextMenu x:Name="VlastnostiContextMenu" Placement="Bottom">
            <MenuItem Header="Farby…" Click="VlastnostiFarby_Click"/>
          </ContextMenu>
        </Button.ContextMenu>
      </Button>
      <Separator/>
      <ToggleButton x:Name="TogPanels" Content="Diely (z bodov)" IsChecked="True"
                    Checked="ViewOption_Changed" Unchecked="ViewOption_Changed"/>
      <ToggleButton x:Name="TogBody" Content="Body dielca" IsChecked="False"
                    Checked="ViewOption_Changed" Unchecked="ViewOption_Changed"/>
      <ToggleButton x:Name="TogCnc" Content="CNC značenie" IsChecked="True"
                    Checked="ViewOption_Changed" Unchecked="ViewOption_Changed"/>
      <ToggleButton x:Name="TogContacts" Content="Dotyky dielov" IsChecked="True"
                    Checked="ViewOption_Changed" Unchecked="ViewOption_Changed"/>
      <ToggleButton x:Name="TogContactLabels" Content="Popisky D…" IsChecked="False"
                    ToolTip="Zobraziť popisky styčných plôch (D1, D2, …) v 3D náhľade"
                    Checked="ViewOption_Changed" Unchecked="ViewOption_Changed"/>
      <Separator/>
      <RadioButton x:Name="RbAssembly" Content="Zostava (WCS)" IsChecked="True"
                   GroupName="Mode" Checked="ViewOption_Changed"/>
      <RadioButton x:Name="RbSingle" Content="Jeden diel"
                   GroupName="Mode" Checked="ViewOption_Changed"/>
      <Separator/>
      <Button Content="Kolíkovať" Click="Kolikovat_Click"
              ToolTip="Dotyky: Ctrl+klik plochy. Diely: Ctrl+klik dielce → partneri (Bok L/P…)"/>
      <Button Content="Skrutky" Click="Skrutky_Click"
              ToolTip="Nová séria skrutiek – dialóg ako pri kolíkoch (stred plochy)"/>
      <Button Content="Generovať" Click="Generovat_Click"
              Style="{StaticResource PrimaryButton}"
              ToolTip="Vygeneruje .xcs pre každý diel (kolíky do plochy + skrutky)"/>
      <Separator/>
      <Button Content="Zoom všetko" Click="ZoomExtents_Click"/>
      <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="12,0"
                 Style="{StaticResource MutedText}"
                 Text="Otvor export. Dotyky môžeš označiť v zozname vľavo."/>
    </ToolBar>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="420"/>
        <ColumnDefinition Width="6"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource PanelBorder}" Margin="8,8,0,8">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto" MinHeight="200" MaxHeight="360"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1.2*"/>
          </Grid.RowDefinitions>

          <DockPanel Grid.Row="0">
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionHeader}" Text="Diely"/>
            <TreeView x:Name="PartList" SelectedItemChanged="PartList_SelectedItemChanged"
                      PreviewMouseLeftButtonDown="PartList_PreviewMouseLeftButtonDown"
                      PreviewMouseRightButtonDown="PartList_PreviewMouseRightButtonDown">
              <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                  <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                  <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                  <Setter Property="Padding" Value="2,1"/>
                </Style>
              </TreeView.ItemContainerStyle>
              <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                  <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsSection}" Value="True">
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Foreground" Value="{StaticResource AppAccentHi}"/>
                          </DataTrigger>
                          <DataTrigger Binding="{Binding IsMultiSelected}" Value="True">
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Foreground" Value="{StaticResource AppAccentHi}"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </HierarchicalDataTemplate>
              </TreeView.ItemTemplate>
              <TreeView.ContextMenu>
                <ContextMenu Opened="PartListContextMenu_Opened">
                  <MenuItem x:Name="PartHideMenuItem" Header="Skryť diel" Click="PartHide_Click"/>
                  <MenuItem Header="Vlastnosti…" Click="PartProperties_Click"/>
                </ContextMenu>
              </TreeView.ContextMenu>
            </TreeView>
          </DockPanel>

          <Border Grid.Row="1" Height="1" Background="{StaticResource AppBorder}" Margin="0,10"/>

          <DockPanel Grid.Row="2">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
              <Button DockPanel.Dock="Right" Content="Upraviť…" Padding="8,2" Margin="8,0,0,0"
                      Click="PartProperties_Click"
                      ToolTip="Otvorí plný dialóg vlastností"/>
              <TextBlock Style="{StaticResource SectionHeader}" VerticalAlignment="Center"
                         Text="Vlastnosti označeného dielca"/>
            </DockPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel x:Name="PartPropsPanel">
                <TextBlock x:Name="PartPropsName" FontWeight="SemiBold" TextWrapping="Wrap"
                           Text="(žiadny výber)"/>
                <TextBlock x:Name="PartPropsSize" Margin="0,4,0,8" Style="{StaticResource DimText}"
                           TextWrapping="Wrap"/>
                <CheckBox x:Name="PartPropsFlip"
                          Content="Otočiť spodkom hore"
                          Margin="0,0,0,6"
                          Checked="PartProps_Changed" Unchecked="PartProps_Changed"/>
                <CheckBox x:Name="PartPropsAbsDole"
                          Content="ABS y dole (inak hore)"
                          Margin="0,0,0,6"
                          Checked="PartProps_Changed" Unchecked="PartProps_Changed"/>
                <DockPanel Margin="0,0,0,6">
                  <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0"
                             Text="ABS páska (mm)"/>
                  <TextBox x:Name="PartPropsAbsPaska" Width="64" HorizontalAlignment="Left"
                           LostFocus="PartProps_Changed" KeyDown="PartPropsField_KeyDown"/>
                </DockPanel>
                <CheckBox x:Name="PartPropsDruheUpnutie"
                          Content="Druhé upnutie (_A/_B)"
                          Margin="0,0,0,6"
                          Checked="PartProps_Changed" Unchecked="PartProps_Changed"/>
                <StackPanel x:Name="PartPropsDruheUpnutiePanel" Margin="0,0,0,6" Visibility="Collapsed">
                  <TextBlock Style="{StaticResource DimText}" Margin="0,0,0,2"
                             Text="Poznámka druhé upnutie (_B)"/>
                  <TextBox x:Name="PartPropsInfoB"
                           MinHeight="40" AcceptsReturn="True" TextWrapping="Wrap"
                           VerticalScrollBarVisibility="Auto"
                           LostFocus="PartProps_Changed"/>
                </StackPanel>
                <TextBlock Style="{StaticResource DimText}" Margin="0,0,0,2" Text="Poznámka XCS (_A)"/>
                <TextBox x:Name="PartPropsInfo"
                         MinHeight="40" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         LostFocus="PartProps_Changed"/>
                <TextBlock x:Name="PartPropsPreview" Margin="0,6,0,0" FontSize="11"
                           Style="{StaticResource DimText}" TextWrapping="Wrap"/>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>

          <Border Grid.Row="3" Height="1" Background="{StaticResource AppBorder}" Margin="0,10"/>

          <DockPanel Grid.Row="4">
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionHeader}"
                       Text="Dotyky (označenie plôch)"/>
            <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0"
                       Style="{StaticResource DimText}" TextWrapping="Wrap"
                       Text="Ctrl+klik = viac plôch → Kolíkovať / Skrutky. Kolík 23/13 mm. Skrutky Ø3 cez plochu (zobr. 3×50)."/>
            <ListBox x:Name="ContactList"
                     DisplayMemberPath="Display"
                     SelectionMode="Extended"
                     SelectionChanged="ContactList_SelectionChanged"
                     PreviewMouseRightButtonDown="ContactList_PreviewMouseRightButtonDown"
                     KeyDown="ContactList_KeyDown">
              <ListBox.ContextMenu>
                <ContextMenu Opened="ContactListContextMenu_Opened">
                  <MenuItem Header="Upraviť kolíky…" Click="EditKoliky_Click"/>
                  <MenuItem Header="Kolíkovať (nová séria)…" Click="Kolikovat_Click"/>
                  <MenuItem x:Name="CopyKolikyMenuItem" Header="Kopírovať kolíky" Click="CopyKoliky_Click"/>
                  <MenuItem x:Name="PasteKolikyMenuItem" Header="Vložiť kolíky" Click="PasteKoliky_Click"/>
                  <Separator/>
                  <MenuItem Header="Upraviť skrutky…" Click="EditSkrutky_Click"/>
                  <MenuItem Header="Skrutky (nová séria)…" Click="Skrutky_Click"/>
                  <Separator/>
                  <MenuItem Header="Odstrániť zo zoznamu" Click="RemoveContacts_Click"/>
                </ContextMenu>
              </ListBox.ContextMenu>
            </ListBox>
          </DockPanel>
        </Grid>
      </Border>

      <Border Grid.Column="1" Background="Transparent"/>

      <DockPanel Grid.Column="2" Margin="0,8,8,8">
        <Border DockPanel.Dock="Top" Margin="0,0,0,8"
                Background="{StaticResource AppPanel}"
                BorderBrush="{StaticResource AppBorder}"
                BorderThickness="1"
                CornerRadius="8">
          <TabControl x:Name="ViewTabs"
                      SelectionChanged="ViewTabs_SelectionChanged">
            <TabItem x:Name="TabSkrinka" Header="Skrinka"/>
            <TabItem x:Name="TabSufliky" Header="Šuflíky" Visibility="Collapsed"/>
            <TabItem x:Name="TabCelaSkrinka" Header="Celá skrinka"
                     ToolTip="Korpus + šuflíky; červené kolíky/vŕtania/CNC; bez plôch dotykov"/>
          </TabControl>
        </Border>
        <Border x:Name="SkrinkaTabsHost" DockPanel.Dock="Top" Margin="0,0,0,8"
                Background="{StaticResource AppPanel}"
                BorderBrush="{StaticResource AppBorder}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="Collapsed">
          <TabControl x:Name="SkrinkaTabs"
                      SelectionChanged="SkrinkaTabs_SelectionChanged"/>
        </Border>
        <StackPanel x:Name="CelaSkrinkaOpacityPanel" DockPanel.Dock="Top"
                    Orientation="Horizontal" Margin="0,0,0,8" Visibility="Collapsed"
                    VerticalAlignment="Center">
          <TextBlock Text="Priehľadnosť materiálov" VerticalAlignment="Center" Margin="0,0,8,0"
                     Style="{StaticResource MutedText}"/>
          <Slider x:Name="PanelOpacitySlider" Width="160" Minimum="5" Maximum="95" Value="38"
                  TickFrequency="5" IsSnapToTickEnabled="False"
                  VerticalAlignment="Center"
                  ValueChanged="PanelOpacitySlider_ValueChanged"
                  ToolTip="Nižšia hodnota = viac priehľadné (lepšie vidno kolíky)"/>
          <TextBlock x:Name="PanelOpacityLabel" Text="38 %" VerticalAlignment="Center"
                     Margin="8,0,0,0" Width="40" Style="{StaticResource MutedText}"/>
        </StackPanel>
        <Border x:Name="ViewportHost"
                BorderBrush="{StaticResource AppBorder}" BorderThickness="1"
                Background="{StaticResource AppBgDeep}" CornerRadius="8">
          <helix:HelixViewport3D x:Name="Viewport"
                                 ZoomExtentsWhenLoaded="True"
                                 ShowCoordinateSystem="True"
                                 CoordinateSystemLabelForeground="#A8B8D8"
                                 Background="#001833">
            <helix:DefaultLights/>
          </helix:HelixViewport3D>
        </Border>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
